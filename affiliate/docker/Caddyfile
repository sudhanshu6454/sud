# Afflino edge (Caddy 2, image caddy:2-alpine): the ONLY public entry to the
# stack. docker-compose.prod.yml runs it as the `edge` service with HOST
# networking (network_mode: host): Caddy listens on 80/tcp, 443/tcp and
# 443/udp (HTTP/3) of the server itself, IPv4 and IPv6, so it sees every
# client's real address (no Docker NAT or userland proxy in front of it, and
# ufw's rules apply to it), keeps certificates in the caddy_data volume, and
# reaches redirect and web on their 127.0.0.1 ports. Variables:
#
#   SITE_HOST          the public host (compose default afflino.com)
#   ACME_EMAIL         optional ACME account email; empty = register without one
#   EDGE_ADDRESS       the site address. Production (compose):
#                      "${SITE_HOST}, www.${SITE_HOST}" = HTTPS with automatic
#                      certificates for exactly those two names (no on-demand
#                      TLS, no wildcard, nothing for other hosts). Plain-HTTP test
#                      mode (docker-compose.edge-test.yml): ":8088" = HTTP on
#                      port 8088, any Host, no certificates.
#   EDGE_BIND          test mode only: a whole `bind` directive ("bind 127.0.0.1"
#                      in docker-compose.edge-test.yml). Unset in production =
#                      Caddy's default, every interface.
#   REDIRECT_UPSTREAM  the click service (production: 127.0.0.1:3001; default
#                      redirect:3001, the service name, for an edge on the
#                      compose network as in docker/README.md's smoke test)
#   WEB_UPSTREAM       the web app (production: 127.0.0.1:3002; default web:3000)
#
# Routing:
#   www.${SITE_HOST}/<path>?<query>  → 301 to https://${SITE_HOST}/<path>?<query>
#   /r/*                             → REDIRECT_UPSTREAM (the click service)
#   everything else                  → WEB_UPSTREAM (the Next.js app; it serves
#                                      /api/* as its same-origin proxy to the
#                                      API, so the API itself is not public;
#                                      provider webhooks and payout callbacks
#                                      use https://${SITE_HOST}/api/v1/...)
#
# Client address: with no `trusted_proxies`, Caddy trusts no client and
# REPLACES any client-supplied X-Forwarded-For with the address it saw (its
# default; asserted end to end in docker/README.md and by the Linode
# installer's rehearsal). X-Real-IP is overwritten with the same address and
# Forwarded is removed, so no header a shopper sends can choose the address
# the redirect hashes into clicks.context.ip_hash. api and redirect run with
# TRUST_PROXY=loopback,uniquelocal: they trust X-Forwarded-For from loopback
# and any private-range peer. The only such peers are the stack's own
# containers and Docker's proxy for the 127.0.0.1-published ports, which is
# how this host-networked edge (and any process on the server itself)
# reaches them; nothing outside the server can connect to those ports.
#
# Admin API: off. With host networking it would listen on the server's
# localhost:2019; nothing here reloads Caddy at run time (a changed Caddyfile
# is applied by restarting the edge, which the installer does).
#
# Logs: no access log is configured (Caddy writes none unless asked), and the
# default log — startup, certificates, errors — drops the client address and
# the request headers from every entry. Security headers (the
# security_headers snippet), on every response of the site, the edge's own
# errors included (a 502 while an upstream is down or restarting, the 413
# for an oversized body: handle_errors below): HSTS (one year, no
# includeSubDomains, no preload), nosniff, Referrer-Policy
# strict-origin-when-cross-origin, X-Frame-Options DENY, no Server, Via or
# X-Powered-By header. The one exception is Caddy's own HTTP → HTTPS 308 on
# port 80 (automatic HTTPS, outside this site block), which carries
# `Server: Caddy` and no HSTS (browsers ignore HSTS over plain HTTP). No
# Content-Security-Policy yet (docs/threat-model.md, open item).
{
	email "{$ACME_EMAIL}"
	admin off

	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}

	servers {
		timeouts {
			read_header 10s
		}
	}
}

(proxy_headers) {
	# X-Forwarded-For is replaced by Caddy itself (see the header above).
	header_up X-Real-IP {remote_host}
	header_up -Forwarded
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
		-Via
		-X-Powered-By
	}
}

{$EDGE_ADDRESS} {
	{$EDGE_BIND}

	import security_headers

	# The edge's own errors (an upstream down: 502; a body over 4 MB: 413):
	# the same headers, a short plain-text body, the error's status.
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}"
	}

	@www host www.{$SITE_HOST}
	redir @www https://{$SITE_HOST}{uri} permanent

	handle /r/* {
		reverse_proxy {$REDIRECT_UPSTREAM:redirect:3001} {
			import proxy_headers
		}
	}

	handle {
		# The web proxy buffers request bodies; the API itself accepts 1 MiB.
		request_body {
			max_size 4MB
		}
		reverse_proxy {$WEB_UPSTREAM:web:3000} {
			import proxy_headers
		}
	}
}
