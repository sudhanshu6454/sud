# One-shot migration / seed runner (db/migrate.mjs, db/seed.ts, db/seed-network.ts).
# Build from the repo root:
#   docker build -f docker/Dockerfile.migrate -t paparazzi/migrate:latest .
#
# The db/ scripts borrow pg and yaml from ../packages/api/node_modules (relative
# to db/), so the image mirrors that path: packages/api/node_modules is a symlink
# to the image's own node_modules, installed from docker/migrate.package.json
# (pg, yaml, tsx pinned to the versions in the workspace pnpm-lock.yaml).
# db/ is copied whole, so the example network file ships at
# /app/db/network.example.yaml (the network seed's default).
#
# Commands (WORKDIR is /app; DATABASE_URL required):
#   node db/migrate.mjs                      # apply pending migrations (default CMD)
#   node db/migrate.mjs --status | --baseline
#   ./node_modules/.bin/tsx db/seed.ts       # TEST-labelled demo org
#   ./node_modules/.bin/tsx db/seed-network.ts --with-demo-programme
#     (reads NETWORK_FILE, default /app/db/network.example.yaml, and WEB_HOST)
#   ./node_modules/.bin/tsx db/meta-network.ts /app/config/meta   # Meta exports → network file (stdout)
#
# NODE_ENV is deliberately not set here: seed-network refuses --with-demo-programme
# under NODE_ENV=production (sandbox rows only). Pass -e NODE_ENV=production to a
# run when that guard is wanted.
ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE}
WORKDIR /app
COPY docker/migrate.package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund --loglevel=error \
 && rm -rf /root/.npm \
 && mkdir -p packages/api \
 && ln -s ../../node_modules packages/api/node_modules \
 && chown -R node:node /app
COPY --chown=node:node db ./db
USER node
CMD ["node", "db/migrate.mjs"]
