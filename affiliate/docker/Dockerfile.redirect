# First-cut production image for @paparazzi/redirect. See Dockerfile.api notes.
FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/redirect/package.json packages/redirect/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/redirect packages/redirect
RUN pnpm --filter @paparazzi/redirect typecheck && \
    pnpm --filter @paparazzi/redirect exec tsc -p tsconfig.json

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/packages/redirect/dist ./dist
COPY --from=build /app/packages/redirect/package.json ./
COPY --from=build /app/node_modules ./node_modules
EXPOSE 3001
CMD ["node", "dist/index.js"]
