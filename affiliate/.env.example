# Copy to .env and adjust. All values here are dev-only placeholders —
# never commit a real .env (it's gitignored).

DATABASE_URL=postgresql://paparazzi:changeme@localhost:5432/paparazzi
REDIS_URL=redis://localhost:6379

# Dev-only. Use a real secret manager / IdP in any shared environment.
JWT_SECRET=dev-only-change-me
STUB_WEBHOOK_SECRET=dev-only-change-me

API_PORT=3000
REDIRECT_PORT=3001
REDIRECT_BASE_URL=http://localhost:3001

# --- demo on a real Postgres (pnpm demo:pg) ---------------------------------
# DEMO_TARGET=postgres makes scripts/demo-money-loop.ts run its assertions on
# a real server instead of pg-mem: a scratch database paparazzi_demo_<8 hex>
# is created on the DATABASE_URL server and dropped at exit. Set
# DEMO_DATABASE_URL instead to use an existing EMPTY database as-is (never
# created or dropped).
# DEMO_TARGET=postgres
# DEMO_DATABASE_URL=postgresql://paparazzi:changeme@localhost:5432/paparazzi_demo_scratch

# --- network seed (pnpm seed:network) ------------------------------------------
# The in-house publisher network's properties (default: db/network.example.yaml,
# TEST data only; --network <path> wins).
# NETWORK_FILE=db/network.example.yaml
# Placeholder logins default to <role>@afflino.invalid (RFC 2606);
# override with the real operator addresses before any non-sandbox use.
# SEED_OWNER_EMAIL=
# SEED_OPERATOR_EMAIL=
# SEED_APPROVER_EMAIL=
# SEED_ADMIN_EMAIL=
# Host of the consumer shop; when set, seed:network also creates a `web`
# property for it and (with --with-demo-programme) the placement reported as
# web_placement_id — the value to put in WEB_PLACEMENT_ID below.
# WEB_HOST=
# WEB_PLACEMENT_ID=

# --- behind a proxy / the click hash / the web's site URL (all optional) -------
# TRUST_PROXY: which peers may set X-Forwarded-For for the api and redirect
# (unset = trust nothing; production compose: loopback,uniquelocal).
# TRUST_PROXY=
# IP_HASH_KEY: >= 32 characters; clicks.context.ip_hash becomes
# HMAC-SHA256(key, ip) instead of the plain SHA-256.
# IP_HASH_KEY=
# SITE_URL: the web's canonical origin (default https://afflino.com).
# SITE_URL=http://localhost:3002
# SITE_INDEXING: "on" lets search engines in; anything else = noindex (default).
# SITE_INDEXING=

