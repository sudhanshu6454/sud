{
  "description": "Paparazzi Affiliate Commerce Platform — foundation scaffold (weeks 3-6 core product). No real merchant credentials, no production secrets, no real money movement.",
  "devDependencies": {
    "pg-mem": "^3.0.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "paparazzi-platform",
  "packageManager": "pnpm@9.12.0",
  "private": true,
  "scripts": {
    "demo": "./packages/api/node_modules/.bin/tsx scripts/demo-money-loop.ts",
    "demo:pg": "DEMO_TARGET=postgres ./packages/api/node_modules/.bin/tsx scripts/demo-money-loop.ts",
    "dev:db": "docker compose up -d postgres redis",
    "migrate": "node db/migrate.mjs",
    "migrate:status": "node db/migrate.mjs --status",
    "migrate:baseline": "node db/migrate.mjs --baseline",
    "seed": "./packages/api/node_modules/.bin/tsx db/seed.ts",
    "seed:network": "./packages/api/node_modules/.bin/tsx db/seed-network.ts",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "load:smoke": "node scripts/load/redirect-soak.js --smoke",
    "load:soak": "node scripts/load/redirect-soak.js"
  },
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ]
}
