# Production environment template — Paparazzi Affiliate Commerce Platform.
#
# Copy to a SECURE location (never commit the filled copy; it is gitignored):
#   cp .env.prod.example /run/secrets/paparazzi.env   # then fill in real values
#
# Values are injected into `docker compose -f docker-compose.prod.yml`
# from the environment at deploy time (see docs/credential-setup.md for how
# each secret is generated, stored in the Secure Vault, and rotated).
#
# Every process.env read in the codebase is covered below. If you add a new
# required env var in code, add it here too.

# ── Postgres (managed: RDS / DigitalOcean Managed PG) ─────────────────────
# Full connection string. Use the provider's private/VPC endpoint.
# Include ?sslmode=require for RDS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/paparazzi

# ── Redis / Valkey (managed: ElastiCache / DigitalOcean Managed Redis) ──────
# BullMQ queues + redirect hot-path. TLS endpoint if the provider requires it
# (rediss://...).
REDIS_URL=redis://HOST:6379

# ── Service bind addresses / ports ──────────────────────────────────────────
# 0.0.0.0 inside the container; the LB / private network fronts them.
API_HOST=0.0.0.0
API_PORT=3000
REDIRECT_PORT=3001

# Public base URL of the redirect service, used to mint click links
# (links are REDIRECT_BASE_URL + /r/<token>). e.g. https://r.example.com
REDIRECT_BASE_URL=https://r.example.com

# ── Web (consumer shop / portal / console) ─────────────────────────────────
# Browser-side API base, baked into the web image at build time (NEXT_PUBLIC_*
# is inlined by Next.js). "/api" = the same-origin proxy served by the web
# server, which forwards to API_BASE at request time. Set an absolute https
# URL only if the browser should call the api origin directly.
NEXT_PUBLIC_API_BASE=/api
# API origin as seen from the web container (compose default: the api service).
API_BASE=http://api:3000
# Read-only bearer (role publisher_analyst) the web server uses for catalogue
# reads. Server-side only — never NEXT_PUBLIC_, never reaches the browser.
# Until the IdP lands this is the dev-grade JWT stub, minted from the api image
# with JWT_SECRET (see docker-compose.prod.yml header). Rotate with JWT_SECRET.
WEB_API_TOKEN=
# The shop's own placement (web_placement_id printed by
# `tsx db/seed-fleet.ts --with-demo-programme` with AFFILIATE_WEB_HOST set).
# Items only carry tracked links for this placement.
WEB_PLACEMENT_ID=
# Shown in <title>, header, footer and the PWA manifest; a rename is a restart.
NEXT_PUBLIC_SITE_NAME=Paparazzi Commerce

# ── Migrate / seed image (docker/Dockerfile.migrate) ───────────────────────
# Host directory holding the fleet's sites.yaml, mounted read-only at
# /app/config for db/seed-fleet.ts (relative to this compose file).
FLEET_SITES_DIR=../autopub/config
# Public host of the consumer shop; when set, seed-fleet also creates its `web`
# property (and, with --with-demo-programme, the placement above).
AFFILIATE_WEB_HOST=
# Placeholder logins default to <role>@marketing-fleet.invalid. Pass the real
# operator addresses to the seed run instead of storing them here, e.g.
# docker compose -f docker-compose.prod.yml run --rm -e FLEET_OWNER_EMAIL=owner@example.com migrate ./node_modules/.bin/tsx db/seed-fleet.ts
# (FLEET_OWNER_EMAIL, FLEET_OPERATOR_EMAIL, FLEET_APPROVER_EMAIL, FLEET_ADMIN_EMAIL)

# ── Secrets (Secure Vault — NEVER in git, never in chat) ───────────────────
# Generate: openssl rand -base64 48
# HMAC/JWT signing for api-issued tokens (auth + signed link payloads); the
# web's WEB_API_TOKEN above is signed with it too.
JWT_SECRET=
# HMAC secret for the stub connector webhook demo flow (workers).
# Replace with the real provider's webhook secret when the payout rail is live.
STUB_WEBHOOK_SECRET=

# ── Payout rail (stub through pilot — placeholders for the real provider) ───
# The sandbox rail in packages/api/src/payout-rail.ts moves no real money.
# When a real provider (e.g. RazorpayX / bank file) is integrated, set:
# PAYOUT_PROVIDER_API_KEY=      # Secure Vault
# PAYOUT_PROVIDER_WEBHOOK_SECRET= # Secure Vault
# PAYOUT_PROVIDER_BASE_URL=      # provider API endpoint
# Until then these stay UNSET and any code path requiring them must fail closed.

# ── Retention windows (counsel owns the numbers; see docs/counsel-briefing.md)
# Sandbox defaults are 365 days each and conservative-long; counsel is
# expected to SHORTEN these before launch. One-line change, no redeploy logic.
RETENTION_CLICK_CONTEXT_DAYS=365
RETENTION_CONVERSION_RAW_DAYS=365
RETENTION_OUTBOX_DAYS=365
# BullMQ cron pattern for the daily purge job.
RETENTION_CRON=0 3 * * *

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# Webhook (Slack / PagerDuty / email gateway) receiving CloudWatch/SNS or
# uptime-check alerts. Placeholder — set the real URL at deploy time.
ALERT_WEBHOOK_URL=

# ── Backups ─────────────────────────────────────────────────────────────────
# Nightly pg_dump target (S3 bucket in the same region, or DO Spaces).
# scripts/backup.sh reads this.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=paparazzi/pg-dumps
# Days to retain manual snapshots / dumps beyond the automated 7-day window.
BACKUP_RETENTION_DAYS=90

# scripts/backup.sh reads these two as well:
# Local dir for dumps before upload (mounted volume on the backup host).
BACKUP_DIR=/var/backups/paparazzi
# Safety interlock: backup.sh refuses to run against a non-localhost DB
# unless this is set — deliberate, keeps a dev script from touching prod
# by accident. Set ONLY on the designated backup host / cron job.
PAPARAZZI_ALLOW_PROD=

# ── Load-test tooling (dev only — scripts/load/redirect-soak.js) ─────────────
# Not needed for deployment; documented here so soak runs are reproducible.
# TARGET_RPS=500
# WARMUP_S=3

# ── Image tagging ───────────────────────────────────────────────────────────
# Pin deployments to an immutable tag (git SHA), not :latest.
IMAGE_TAG=
