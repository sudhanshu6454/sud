# Production environment for Afflino (afflino.com) — every variable
# docker-compose.prod.yml (+ docker-compose.single-host.yml) and the code read.
#
# This file is a TEMPLATE: it holds no values. The filled copy lives outside
# git (the repository is public) with owner-only permissions: on the Linode
# the installer (deploy/linode/install.sh) writes /etc/afflino/afflino.env
# (root, 0600) with every secret generated, and compose reads it with
#   docker compose --env-file /etc/afflino/afflino.env -f docker-compose.prod.yml -f docker-compose.single-host.yml up -d --build
# (never `export` the values: a variable in the shell wins over --env-file).
# Secrets are generated on the server or entered through hidden prompts
# (read -s), never typed on a command line and never printed.
# docs/credential-setup.md: generation, storage, rotation.
#
# Legend on each variable:
#   REQUIRED / OPTIONAL   whether compose (or the service) refuses to start without it
#   SECRET                keep it out of logs, chat, shell history and git
#   default               what compose uses when it is unset or empty
#   read by               the service(s) that receive it
#
# Only these are REQUIRED on the single-host Linode: POSTGRES_PASSWORD,
# JWT_SECRET, STUB_WEBHOOK_SECRET. IP_HASH_KEY is optional but should be set
# before the first real click. Everything else has a production default.

# ── Site ──────────────────────────────────────────────────────────────────
# OPTIONAL. default afflino.com. read by: edge (site address, www redirect),
# and the defaults of REDIRECT_BASE_URL, SITE_URL and the seed's WEB_HOST.
# Bare hostname, no scheme. The edge requests certificates for exactly
# SITE_HOST and www.SITE_HOST (DNS for both must point at this server).
SITE_HOST=
# OPTIONAL. default empty (ACME account without an email). read by: edge.
# Where the certificate authority may send expiry / problem notices. Use an
# address the owner reads; none is assumed here.
ACME_EMAIL=
# OPTIONAL. default off. read by: web (runtime). The indexing gate: "on" lets
# search engines index the public pages (robots.txt allows them and names the
# sitemap). Anything else = pre-launch: robots.txt "Disallow: /", an empty
# sitemap, noindex,nofollow on every page. The owner's switch: the figures in
# packages/web/lib/site-copy.ts are confirmed (2026-09-29); the terms,
# privacy and contact pages are still stubs.
SITE_INDEXING=
# OPTIONAL. default https://${SITE_HOST}. read by: web (runtime). Origin for
# canonical URLs, og:url, robots.txt and the sitemap.
SITE_URL=
# OPTIONAL. default Afflino. read by: web (runtime). Site name in <title>, the
# footer and the PWA manifest (a rename is a restart, not a rebuild).
NEXT_PUBLIC_SITE_NAME=

# ── Databases: single host (docker-compose.single-host.yml, the pilot) ──────
# REQUIRED with the single-host override. SECRET. read by: postgres, and
# written into DATABASE_URL for api, redirect, workers and migrate.
# URL-safe characters only (it goes into a connection string); generate with
#   openssl rand -hex 32
# It is fixed when the pgdata volume is first created: changing it later
# needs ALTER USER inside Postgres as well.
POSTGRES_PASSWORD=
# OPTIONAL. defaults afflino / afflino. read by: postgres (single host).
POSTGRES_USER=
POSTGRES_DB=

# ── Databases: managed (docker-compose.prod.yml alone) ──────────────────────
# REQUIRED without the single-host override (ignored with it). SECRET (the URL
# carries the password). read by: api, redirect, workers; migrate (DATABASE_URL).
# Compose does not refuse them empty (the override supplies them); an empty
# value still stops the stack: migrate exits "DATABASE_URL is not set" and
# api / redirect / workers refuse to boot under NODE_ENV=production without
# REDIS_URL. Use the provider's private endpoint (?sslmode=require where
# offered; rediss:// for TLS Redis).
DATABASE_URL=
REDIS_URL=

# ── API ───────────────────────────────────────────────────────────────────
# REQUIRED. SECRET. read by: api. Signs API tokens (the JWT dev stub until an
# identity provider lands), including WEB_API_TOKEN below and the link
# route_signature. Rotating it invalidates every token (re-mint WEB_API_TOKEN).
#   openssl rand -hex 48
JWT_SECRET=
# OPTIONAL. default https://${SITE_HOST}. read by: api. Public origin of the
# tracked links: every link is REDIRECT_BASE_URL/r/<token>, served by the
# edge's /r/* route. Changing it does not rewrite links already published.
REDIRECT_BASE_URL=
# OPTIONAL. default loopback,uniquelocal. read by: api, redirect. Which peers
# may set X-Forwarded-For: "true", a hop count, or a comma list of addresses,
# CIDR ranges and loopback / linklocal / uniquelocal. The default trusts the
# edge and the web proxy on the compose network and nothing else; the edge
# overwrites client-supplied X-Forwarded-For. An invalid value fails the boot.
TRUST_PROXY=

# ── Redirect (the click service) ──────────────────────────────────────────
# OPTIONAL (strongly recommended). SECRET. read by: redirect. Key for
# clicks.context.ip_hash = HMAC-SHA256(key, client address); at least 32
# characters, or the redirect refuses to boot. Empty = plain SHA-256, which
# for IPv4 addresses is reversible by enumeration. Set it before the first
# real click and keep it: hashes made under a different key (or before a key
# was set) do not compare. Whether the hash is personal data and who holds
# the key are counsel items (docs/threat-model.md §4.11).
#   openssl rand -hex 32
IP_HASH_KEY=

# ── Workers ───────────────────────────────────────────────────────────────
# REQUIRED. SECRET. read by: workers. HMAC secret of the stub connector's
# webhook demo flow; replaced by the real provider's secret when one exists.
#   openssl rand -hex 32
STUB_WEBHOOK_SECRET=
# OPTIONAL. defaults 365 / 365 / 365 / "0 3 * * *". read by: workers.
# Retention windows in days and the daily purge schedule. The 365-day values
# are placeholders: counsel sets the real windows (docs/counsel-briefing.md).
RETENTION_CLICK_CONTEXT_DAYS=
RETENTION_CONVERSION_RAW_DAYS=
RETENTION_OUTBOX_DAYS=
RETENTION_CRON=
# OPTIONAL. read by: deploy/linode/amazon.sh (passed to the api image's
# Amazon CLI, dist/cli/amazon.js setup), not by the running services. The
# amazon.in Associates Store ID (the default tracking ID, "<store>-21") and the
# in-house network's share of Amazon's fee in basis points (0..10000; used for
# the first contract only). Entered at amazon.sh keys' prompts (the Store ID
# hidden), never typed on a command line. Real values only on the server.
AMAZON_STORE_ID=
AMAZON_PUBLISHER_SHARE_BPS=
# OPTIONAL. default off. read by: web (runtime). "on" = every page's footer
# carries Amazon's Associate statement ("As an Amazon Associate I earn from
# qualifying purchases."). Set by amazon.sh setup, once the account exists.
AMAZON_ASSOCIATE=
# OPTIONAL. SECRET (the id and the secret). read by: workers. Amazon Creators
# API credentials (Associates Central, after final acceptance and 10 qualifying
# sales in 30 days; packages/workers/src/amazon/creators-api.ts). Unset = no
# price refresh: Amazon offers show no price, links and conversions work.
# Never typed on a command line; entered at amazon.sh keys' hidden prompts.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# OPTIONAL. default 3.2 (the India / EU token endpoint) / "17 * * * *".
AMAZON_CREATORS_CREDENTIAL_VERSION=
AMAZON_REFRESH_CRON=

# ── Celebrity looks and comment replies (0007) ────────────────────────────
# OPTIONAL. SECRET. read by: api (the Meta webhook's X-Hub-Signature-256) and
# workers (appsecret_proof on every Graph call). The Meta app's App Secret.
# Unset = the webhook answers 503 and nothing is sent. Entered at
# deploy/linode/looks.sh keys' hidden prompt, never typed on a command line.
META_APP_SECRET=
# OPTIONAL. SECRET. read by: api. The verify token the owner chooses and
# types into Meta's App Dashboard too (webhook verification).
META_VERIFY_TOKEN=
# OPTIONAL. SECRET. read by: workers. The Meta system user's token; Page
# tokens are derived from it in memory (/me/accounts), never stored.
META_SYSTEM_USER_TOKEN=
# OPTIONAL. default v26.0. read by: workers.
META_GRAPH_VERSION=
# OPTIONAL (REQUIRED for comment replies). SECRET. read by: api. Keys the
# hash of commenter ids (reply_events / reply_suppressions store only
# HMAC-SHA256(key, platform:account:id)); at least 32 characters. Generated
# by the installer; keep it (hashes under another key do not compare, so the
# opt-out list would stop matching).
#   openssl rand -hex 32
COMMENT_ID_HASH_KEY=
# OPTIONAL. default off. read by: workers. off = nothing is sent; shadow =
# every check runs, nothing is sent (reply_events.status skipped_shadow);
# on = one private reply per matched comment (needs META_APP_SECRET and
# META_SYSTEM_USER_TOKEN; without them 'on' behaves as off). Set by
# looks.sh replies, which refuses 'on' while /privacy is the stub page.
COMMENT_REPLIES_SENDING=
# OPTIONAL. default 5000. read by: workers. How often ready replies are enqueued (ms).
COMMENT_REPLIES_SWEEP_MS=
# OPTIONAL. default 30 (a placeholder pending counsel). read by: workers.
# Days before comment-reply events are deleted (the daily counts and the
# opt-out list are kept).
RETENTION_REPLY_EVENTS_DAYS=
# OPTIONAL. default "7 * * * *". read by: workers. The analytics rollups.
ANALYTICS_ROLLUP_CRON=
# OPTIONAL. SECRET. read by: api and web. The secret the API presents to the
# web's /internal/revalidate after a takedown (the edge 404s /internal/*
# from outside). Generated by the installer.
#   openssl rand -hex 32
WEB_REVALIDATE_SECRET=
# OPTIONAL. default http://web:3000/internal/revalidate. read by: api.
WEB_REVALIDATE_URL=
# OPTIONAL. default 240. read by: api. Requests a minute per visitor address
# to the public read API (/v1/public/*); over it → 429 with Retry-After. Per
# api process; the web's own server-side calls are not counted. Many phones
# behind one carrier address share one allowance: raise it if 429s appear.
PUBLIC_RATE_PER_MINUTE=
# OPTIONAL. default 1200. read by: api. The same for the Meta webhook's
# POSTs (Meta retries a refused delivery for 36 hours).
WEBHOOK_RATE_PER_MINUTE=
# OPTIONAL. default on (with Redis). read by: api. "off" stops the api
# keeping each public answer and still for 30 s (a takedown drops them at
# once either way: the Redis key public:epoch).
PUBLIC_API_CACHE=
# OPTIONAL. default off. read by: web (runtime). "on" lets search engines
# index celebrity pages (the looks of the Spotted feed, the hubs /c/<slug>,
# the storefronts /s/<slug>, and /shop while its feed shows one); off keeps
# them noindex and out of the sitemap even when SITE_INDEXING=on. The
# owner's decision with counsel.
CELEBRITY_INDEXING=
# OPTIONAL. default afflino. read by: web (runtime). The organisation whose
# celebrity looks the public pages show (the public read API
# /v1/public/<slug>/…, no token): the in-house network's organisation.
PUBLIC_ORG_SLUG=

# ── Web (the Afflino app and shop) ────────────────────────────────────────
# OPTIONAL. SECRET. read by: web (server only; never NEXT_PUBLIC_, never sent
# to the browser). Read-only publisher_analyst bearer the shop uses for
# catalogue reads. Unset = the shop renders labelled TEST demo data. Minted
# with the api image after the network seed (README.md "Deploying
# afflino.com"); rotates with JWT_SECRET.
WEB_API_TOKEN=
# OPTIONAL. read by: web. The shop's own placement id (web_placement_id in the
# network seed's output). Unset = items carry no tracked link.
WEB_PLACEMENT_ID=
# OPTIONAL. default http://api:3000. read by: web (runtime). The API as seen
# from the web container; also the target of the web's /api/* proxy.
API_BASE=
# OPTIONAL. default /api. read by: web BUILD (a build argument, inlined into
# the browser bundle). "/api" = the same-origin proxy. Changing it needs
# `up -d --build web`.
NEXT_PUBLIC_API_BASE=

# ── Seeds (migrate image; db/README.md) ───────────────────────────────────
# OPTIONAL. default empty = the TEST example network file shipped in the
# image. read by: migrate (seed-network.ts). For the operator's own network:
# /app/config/network.yaml with the volume on the migrate service uncommented.
NETWORK_FILE=
# OPTIONAL. default ${SITE_HOST}. read by: migrate (seed-network.ts). The
# shop's own host; seed-network creates its `web` property and, with
# --with-demo-programme, the placement printed as web_placement_id.
WEB_HOST=
# Not stored here: the four seeded logins default to <role>@afflino.invalid
# (RFC 2606); pass real operator addresses to the seed run itself with
# -e SEED_OWNER_EMAIL=... (also SEED_OPERATOR_EMAIL, SEED_APPROVER_EMAIL,
# SEED_ADMIN_EMAIL).

# ── Compose ───────────────────────────────────────────────────────────────
# OPTIONAL. default latest. read by: compose (image tags paparazzi/*:IMAGE_TAG).
# Pin a release to an immutable tag (e.g. release-YYYYMMDD-HHMM), not latest.
IMAGE_TAG=
# OPTIONAL. default info. Passed to api, redirect, workers and web; today no
# service reads it (the api and redirect log at info).
LOG_LEVEL=

# ── Backups (scripts/backup.sh, docs/runbooks/backup-restore.md) ──────────
# OPTIONAL. read by: scripts/backup.sh on the backup host, not by compose.
# Local directory for dumps.
BACKUP_DIR=
# Safety interlock: backup.sh refuses a non-localhost database unless this is
# set. Set it ONLY for the designated backup job.
PAPARAZZI_ALLOW_PROD=
# OPTIONAL. default paparazzi_restore_drill. read by: scripts/restore.sh (the
# restore drill's scratch database; PGHOST / PGPORT / PGUSER / PGPASSWORD as
# for psql).
PAPARAZZI_RESTORE_DB=

# ── Payout rail (stub through pilot; not read by any code yet) ─────────────
# The sandbox rail in packages/api/src/payout-rail.ts moves no real money.
# When a real provider is integrated its credentials are added here (SECRET),
# and any code path that needs them must fail closed while they are unset.

# ── Not read from this file ───────────────────────────────────────────────
# API_HOST=0.0.0.0, API_PORT=3000, REDIRECT_PORT=3001 and NODE_ENV=production
# are fixed in docker-compose.prod.yml. DEMO_TARGET / DEMO_DATABASE_URL and
# the load-test knobs (TARGET_RPS, WARMUP_S, DURATION_S, BASE_URL, R_TOKEN)
# are development-only (.env.example, scripts/load/).
