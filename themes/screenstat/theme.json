{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "740px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        { "slug": "coral", "color": "#EE5A3C", "name": "Coral" },
        { "slug": "coral-dark", "color": "#C8412A", "name": "Coral dark" },
        { "slug": "ink", "color": "#16181D", "name": "Ink" },
        { "slug": "ink-soft", "color": "#2B2F36", "name": "Ink soft" },
        { "slug": "muted", "color": "#5C6068", "name": "Muted" },
        { "slug": "border", "color": "#E4E2DD", "name": "Border" },
        { "slug": "surface", "color": "#F7F6F3", "name": "Surface" },
        { "slug": "cream", "color": "#F4EDE2", "name": "Cream" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/InterVariable.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "size": "0.8125rem", "name": "X Small" },
        { "slug": "small", "size": "0.9375rem", "name": "Small" },
        { "slug": "medium", "size": "1.0625rem", "name": "Medium" },
        {
          "slug": "large",
          "size": "1.375rem",
          "name": "Large",
          "fluid": { "min": "1.25rem", "max": "1.5rem" }
        },
        {
          "slug": "x-large",
          "size": "1.875rem",
          "name": "X Large",
          "fluid": { "min": "1.625rem", "max": "2.125rem" }
        },
        {
          "slug": "xx-large",
          "size": "2.75rem",
          "name": "XX Large",
          "fluid": { "min": "2rem", "max": "3.25rem" }
        },
        {
          "slug": "display",
          "size": "4rem",
          "name": "Display",
          "fluid": { "min": "2.75rem", "max": "5rem" }
        }
      ]
    },
    "spacing": {
      "units": [ "px", "em", "rem", "%", "vh", "vw" ],
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "1" },
        { "slug": "30", "size": "1rem", "name": "2" },
        { "slug": "40", "size": "1.5rem", "name": "3" },
        { "slug": "50", "size": "2.5rem", "name": "4" },
        { "slug": "60", "size": "4rem", "name": "5" },
        { "slug": "70", "size": "6rem", "name": "6" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      },
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--coral)" },
        "typography": { "textDecoration": "none" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--coral-dark)" },
          "typography": { "textDecoration": "underline" }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "600",
          "letterSpacing": "-0.022em",
          "lineHeight": "1.15"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "caption": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--coral)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": { "radius": "6px" },
        "typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--small)" },
        "spacing": { "padding": { "top": "0.7em", "bottom": "0.7em", "left": "1.3em", "right": "1.3em" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--coral-dark)" } }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": { "fontWeight": "600", "letterSpacing": "-0.024em", "lineHeight": "1.12" }
      },
      "core/table": {
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--border)" }
      },
      "core/quote": {
        "border": { "left": { "width": "3px", "color": "var(--wp--preset--color--coral)" } },
        "spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-wide", "title": "Wide page (no sidebar)", "postTypes": [ "page" ] }
  ]
}
