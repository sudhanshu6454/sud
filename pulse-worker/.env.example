# Copy to .env — never commit .env. Leave a key blank to disable that connector.
YT_API_KEY=
META_SYSTEM_USER_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
GSC_PROPERTIES=sc-domain:screenstat.in,sc-domain:bollywoodchronicle.com,sc-domain:movified.co,sc-domain:indenews.in
SERPAPI_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBS=bollywood+BollyBlindsNGossip+IndianCinema+tollywood+kollywood+MalayalamMovies+boxoffice+movies
# TMDB — free key at themoviedb.org/settings/api (v3 key or v4 read token both work).
# Free key = non-commercial use only; licence from TMDB before publishing the numbers.
TMDB_API_KEY=
# Trakt — free client id at trakt.tv/oauth/applications (anticipated chart = watchlist adds)
TRAKT_CLIENT_ID=
# Instagram Business Discovery — any Instagram professional account id you own, from config/assets.json
IG_SELF_USER_ID=
# KOBIS (Korean Film Council) — free key at kobis.or.kr; calibration only, writes no Pulse signal
KOBIS_KEY=
# IMDb non-commercial datasets — set to the literal word below to acknowledge the licence
IMDB_DATASETS_ACK=
# WordPress ingest target (leave WP_URL blank to only write payloads to ./data/out/)
WP_URL=https://screenstat.in
WP_USER=
WP_APP_PASSWORD=
# Optional LLM sentiment classifier (much better on Hinglish sarcasm). Set both to enable; lexicon is the fallback.
ANTHROPIC_API_KEY=
SENTIMENT_MODEL=
# Optional tuning
HASHTAG_COVERAGE=2.5
USER_AGENT=ScreenstatPulse/1.0 (contact@screenstat.in)
