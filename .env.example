# ======================================================================
#  Copy to .env and fill in. Never commit .env.
#  Per-site variables use the site key from autopub/config/sites.yaml:
#  MENTALIST = marketingmentalist.in, CRAZY = crazy4marketing.com, JUNKIES = marketingjunkies.in
# ======================================================================

# ---- server / TLS -----------------------------------------------------
LETSENCRYPT_EMAIL=you@example.com
TZ=Asia/Kolkata

# ---- databases (use long random strings: openssl rand -hex 24) --------
DB_ROOT_PASSWORD=
WP_MENTALIST_DB_PASSWORD=
WP_CRAZY_DB_PASSWORD=
WP_JUNKIES_DB_PASSWORD=

# ---- WordPress admin (same admin on all sites) ------------------------
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=you@example.com
WP_THEME=astra
WP_PLUGINS=wordpress-seo wp-super-cache

# Filled in automatically by infra/wp/init-sites.sh (application passwords for the autopub user)
WP_MENTALIST_USER=autopub
WP_MENTALIST_APP_PASSWORD=
WP_CRAZY_USER=autopub
WP_CRAZY_APP_PASSWORD=
WP_JUNKIES_USER=autopub
WP_JUNKIES_APP_PASSWORD=

# ---- Claude (writes the curated articles + captions) ------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACKS=off   # disable server-side refusal fallbacks

# ---- provisioning (only needed on your laptop, not on the server) -----
LINODE_TOKEN=
LINODE_REGION=ap-west
LINODE_TYPE=g6-standard-2
GODADDY_API_KEY=
GODADDY_API_SECRET=
DNS_PROVIDER=godaddy

# ======================================================================
#  SOCIAL ACCOUNTS - one block per site. Leave a platform blank to skip it.
#  Image + link : twitter, facebook, linkedin, pinterest, telegram, threads
#  Image only   : instagram (link goes in the caption as text)
# ======================================================================

# ---- marketingmentalist.in (MENTALIST) --------------------------------
TWITTER_MENTALIST_API_KEY=
TWITTER_MENTALIST_API_SECRET=
TWITTER_MENTALIST_ACCESS_TOKEN=
TWITTER_MENTALIST_ACCESS_SECRET=
FACEBOOK_MENTALIST_PAGE_ID=
FACEBOOK_MENTALIST_PAGE_TOKEN=
INSTAGRAM_MENTALIST_USER_ID=
INSTAGRAM_MENTALIST_ACCESS_TOKEN=
LINKEDIN_MENTALIST_ORG_URN=urn:li:organization:
LINKEDIN_MENTALIST_ACCESS_TOKEN=
PINTEREST_MENTALIST_ACCESS_TOKEN=
PINTEREST_MENTALIST_BOARD_ID=
TELEGRAM_MENTALIST_BOT_TOKEN=
TELEGRAM_MENTALIST_CHAT_ID=@marketingmentalist
THREADS_MENTALIST_USER_ID=
THREADS_MENTALIST_ACCESS_TOKEN=

# ---- crazy4marketing.com (CRAZY) --------------------------------------
TWITTER_CRAZY_API_KEY=
TWITTER_CRAZY_API_SECRET=
TWITTER_CRAZY_ACCESS_TOKEN=
TWITTER_CRAZY_ACCESS_SECRET=
FACEBOOK_CRAZY_PAGE_ID=
FACEBOOK_CRAZY_PAGE_TOKEN=
INSTAGRAM_CRAZY_USER_ID=
INSTAGRAM_CRAZY_ACCESS_TOKEN=
LINKEDIN_CRAZY_ORG_URN=urn:li:organization:
LINKEDIN_CRAZY_ACCESS_TOKEN=
PINTEREST_CRAZY_ACCESS_TOKEN=
PINTEREST_CRAZY_BOARD_ID=
TELEGRAM_CRAZY_BOT_TOKEN=
TELEGRAM_CRAZY_CHAT_ID=@crazy4marketing
THREADS_CRAZY_USER_ID=
THREADS_CRAZY_ACCESS_TOKEN=

# ---- marketingjunkies.in (JUNKIES) ------------------------------------
TWITTER_JUNKIES_API_KEY=
TWITTER_JUNKIES_API_SECRET=
TWITTER_JUNKIES_ACCESS_TOKEN=
TWITTER_JUNKIES_ACCESS_SECRET=
FACEBOOK_JUNKIES_PAGE_ID=
FACEBOOK_JUNKIES_PAGE_TOKEN=
INSTAGRAM_JUNKIES_USER_ID=
INSTAGRAM_JUNKIES_ACCESS_TOKEN=
LINKEDIN_JUNKIES_ORG_URN=urn:li:organization:
LINKEDIN_JUNKIES_ACCESS_TOKEN=
PINTEREST_JUNKIES_ACCESS_TOKEN=
PINTEREST_JUNKIES_BOARD_ID=
TELEGRAM_JUNKIES_BOT_TOKEN=
TELEGRAM_JUNKIES_CHAT_ID=@marketingjunkies
THREADS_JUNKIES_USER_ID=
THREADS_JUNKIES_ACCESS_TOKEN=
