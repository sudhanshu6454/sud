# ======================================================================
#  PULSE WORKER (pulse-worker/) - fills Screenstat Pulse's film signals and posts the daily
#  reading. Runs its own schedule inside its container (pulse-worker/README.md §5); needs
#  nothing else running. Full setup, one connector at a time: pulse-worker/README.md.
#  Leave a connector's keys blank to skip it - the rest still run.
# ======================================================================
WP_URL=https://screenstat.in
WP_USER=
WP_APP_PASSWORD=
YT_API_KEY=
# Meta: every token below is generated under the app "postautomation", App ID 259982148841906.
# There is deliberately no APP_ID setting - a token already carries its issuing app - so the app is
# chosen in Business Settings when the token is made. Do NOT use "Post Automation 2"
# (298449321694397): it is a different app with its own, different App Review approvals.
META_SYSTEM_USER_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
GSC_PROPERTIES=sc-domain:screenstat.in
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TMDB_API_KEY=
TRAKT_CLIENT_ID=
IG_SELF_USER_ID=
KOBIS_KEY=
IMDB_DATASETS_ACK=
# optional LLM sentiment classifier - reuses ANTHROPIC_API_KEY above; set SENTIMENT_MODEL to enable it
SENTIMENT_MODEL=

# Reel narration (autopub/speech.py). The Indian English voices are cloud voices, free at this volume.
# Microsoft: create a "Speech" resource at portal.azure.com (free F0 tier, 500k chars/month), copy KEY 1
# and the region (e.g. centralindia). Set reel_voice: azure:en-IN-AartiNeural in sites.yaml.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Google: an API key with the Cloud Text-to-Speech API enabled (1M chars/month free for Neural2).
# Set reel_voice: google:en-IN-Neural2-A in sites.yaml.
GOOGLE_TTS_API_KEY=

# ---- OpenSEO (search data for the writer, rank tracking) --------------
# Self-hosted beside the fleet (the `openseo` service). It needs a DataForSEO key: the "Base64"
# credentials from https://app.dataforseo.com/api-access (base64 of email:password). Pay-as-you-go;
# keyword research costs ~30-100 credits per seed and the pipeline asks for one per article.
DATAFORSEO_API_KEY=
# Where autopub finds the MCP server (the default is the service on the internal network). Point it
# at https://app.openseo.so/mcp with OPENSEO_API_KEY to use the hosted service instead.
# OPENSEO_URL=http://openseo:3001/mcp
# OPENSEO_API_KEY=
# Optional: SAM, OpenSEO's in-app agent (an OpenRouter key)
# OPENROUTER_API_KEY=

# ======================================================================
#  AFFILIATE PLATFORM (affiliate/) - the Paparazzi affiliate shop, click redirector, v1 API and
#  workers, on their own Postgres + Redis beside the fleet. Off by default: nothing below starts
#  until COMPOSE_PROFILES is set. Bring-up: fill the three hosts and the four secrets, point the
#  hosts at this server in DNS, then `make affiliate-up`, then `make affiliate-seed` (prints
#  web_placement_id), put that id in AFFILIATE_WEB_PLACEMENT_ID and run `make affiliate-up` again.
# ======================================================================
# Set to affiliate to run the affiliate services with the fleet (blank = the fleet alone).
COMPOSE_PROFILES=
# Public host of the consumer shop (affiliate_web), e.g. shop.example.com - host only, no scheme, no path.
AFFILIATE_WEB_HOST=
# Public host of the click redirector (affiliate_redirect): every affiliate link is https://<this host>/r/<token>.
AFFILIATE_LINK_HOST=
# Public host of the v1 API (affiliate_api), used by the publisher portal and editorial console.
AFFILIATE_API_HOST=
# Password of the affiliate Postgres. Hex only (it is spliced into DATABASE_URL): openssl rand -hex 32
AFFILIATE_DB_PASSWORD=
# Signs the API's JWTs and link payloads: openssl rand -hex 32
AFFILIATE_JWT_SECRET=
# HMAC secret of the stub connector webhook (workers) until a real merchant feed lands: openssl rand -hex 32
AFFILIATE_STUB_WEBHOOK_SECRET=
# Bearer token the shop sends to the API. This is the dev-grade JWT stub, not a real login: there is no
# identity provider yet (affiliate/CLAUDE.md, "Auth is a JWT stub"), so mint it with the API's
# affiliate/packages/api/scripts/mint-dev-token.mjs, signed with AFFILIATE_JWT_SECRET, --org-id set to the
# org_id that `make affiliate-seed` prints, and re-mint whenever the secret rotates or the ttl runs out.
AFFILIATE_WEB_API_TOKEN=
# Placement the shop's own links are attributed to: the web_placement_id printed by `make affiliate-seed`
# (needs AFFILIATE_WEB_HOST set before seeding).
AFFILIATE_WEB_PLACEMENT_ID=
# Site name in the web app's page titles, footer and PWA manifest (the web app is Afflino; the logo is fixed).
AFFILIATE_SITE_NAME=Afflino
# When the workers run the daily retention purge (cron, server time).
AFFILIATE_RETENTION_CRON=0 3 * * *
# Retention windows in days (365 placeholders until counsel sets the real numbers; shorten, do not lengthen).
# AFFILIATE_RETENTION_CLICK_CONTEXT_DAYS=365
# AFFILIATE_RETENTION_CONVERSION_RAW_DAYS=365
# AFFILIATE_RETENTION_OUTBOX_DAYS=365
