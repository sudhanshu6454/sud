# ---- screenstat.in (SCREENSTAT) ---------------------------------------
TWITTER_SCREENSTAT_API_KEY=
TWITTER_SCREENSTAT_API_SECRET=
TWITTER_SCREENSTAT_ACCESS_TOKEN=
TWITTER_SCREENSTAT_ACCESS_SECRET=
FACEBOOK_SCREENSTAT_PAGE_ID=
FACEBOOK_SCREENSTAT_PAGE_TOKEN=
