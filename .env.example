# ======================================================================
#  Copy to .env and fill in. Never commit .env.
#  Per-site variables use the site key from autopub/config/sites.yaml:
#  MENTALIST = marketingmentalist.in, CRAZY = crazy4marketing.com, JUNKIES = marketingjunkies.in,
#  SCREENSTAT = screenstat.in, FILMYBUFF = filmybuff.com
# ======================================================================

# ---- server / TLS -----------------------------------------------------
LETSENCRYPT_EMAIL=you@example.com
TZ=Asia/Kolkata

# ---- databases (use long random strings: openssl rand -hex 24) --------
DB_ROOT_PASSWORD=
WP_MENTALIST_DB_PASSWORD=
WP_CRAZY_DB_PASSWORD=
WP_JUNKIES_DB_PASSWORD=
WP_SCREENSTAT_DB_PASSWORD=
WP_FILMYBUFF_DB_PASSWORD=

# ---- WordPress admin (same admin on all sites) ------------------------
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=you@example.com
WP_THEME=astra
WP_PLUGINS=wordpress-seo wp-super-cache limit-login-attempts-reloaded

# Filled in automatically by infra/wp/init-sites.sh (application passwords for the autopub user)
WP_MENTALIST_USER=autopub
WP_MENTALIST_APP_PASSWORD=
WP_CRAZY_USER=autopub
WP_CRAZY_APP_PASSWORD=
WP_JUNKIES_USER=autopub
WP_JUNKIES_APP_PASSWORD=
WP_SCREENSTAT_USER=autopub
WP_SCREENSTAT_APP_PASSWORD=
WP_FILMYBUFF_USER=autopub
WP_FILMYBUFF_APP_PASSWORD=

# ---- The model that writes the curated articles + captions ------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
# ANTHROPIC_FALLBACKS=off   # disable server-side refusal fallbacks
#
# Another provider can serve this through an Anthropic-compatible endpoint - autopub speaks the
# Messages API and the SDK honours ANTHROPIC_BASE_URL. To move the whole fleet to DeepSeek, put its
# key in ANTHROPIC_API_KEY above and set:
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   ANTHROPIC_MODEL=deepseek-v4-pro
# Known differences, already handled in rewrite.py: DeepSeek ignores prompt caching (cache_control)
# and ignores output_config.format, so the JSON schema is sent in the prompt as well and the reply
# is parsed defensively with one corrective retry. Server-side fallbacks switch themselves off for
# any non-Anthropic base URL. Expect article quality to shift - the prompts were tuned on Claude, so
# point one site at it first and read the result before moving all four.

# ---- provisioning (only needed on your laptop, not on the server) -----
LINODE_TOKEN=
LINODE_REGION=ap-west
LINODE_TYPE=g6-standard-2
GODADDY_API_KEY=
GODADDY_API_SECRET=
DNS_PROVIDER=godaddy

# ======================================================================
#  SOCIAL ACCOUNTS - one block per site. Leave a platform blank to skip it.
#  Image + link : twitter, facebook, linkedin, pinterest, telegram, threads
#  Image only   : instagram (link goes in the caption as text)
# ======================================================================

# ---- X developer app (shared by every site; Basic tier for our volume) --
# Written by `python3 infra/x-auth.py SITE=handle ...`, which also fills the per-site TWITTER_* below.
X_API_KEY=
X_API_SECRET=

# ---- LinkedIn app (shared by every site) ------------------------------
# Written by `python3 infra/linkedin-auth.py auth`; per-site ORG_URN/ACCESS_TOKEN below by `wire`.
# Tokens last 60 days: `python3 infra/linkedin-auth.py refresh` renews them (check warns at 10 days).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES=

