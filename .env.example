# ======================================================================
#  PULSE WORKER (pulse-worker/) - fills Screenstat Pulse's film signals and posts the daily
#  reading. Runs its own schedule inside its container (pulse-worker/README.md §5); needs
#  nothing else running. Full setup, one connector at a time: pulse-worker/README.md.
#  Leave a connector's keys blank to skip it - the rest still run.
# ======================================================================
WP_URL=https://screenstat.in
WP_USER=
WP_APP_PASSWORD=
YT_API_KEY=
# Meta: every token below is generated under the app "postautomation", App ID 259982148841906.
# There is deliberately no APP_ID setting - a token already carries its issuing app - so the app is
# chosen in Business Settings when the token is made. Do NOT use "Post Automation 2"
# (298449321694397): it is a different app with its own, different App Review approvals.
META_SYSTEM_USER_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
GSC_PROPERTIES=sc-domain:screenstat.in
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TMDB_API_KEY=
TRAKT_CLIENT_ID=
IG_SELF_USER_ID=
KOBIS_KEY=
IMDB_DATASETS_ACK=
# optional LLM sentiment classifier - reuses ANTHROPIC_API_KEY above; set SENTIMENT_MODEL to enable it
SENTIMENT_MODEL=
